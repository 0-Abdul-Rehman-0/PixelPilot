# Environment Variables Example for PixelPilot
# Copy this file to .env and set your API key

# Google AI Studio API key (required at runtime; never commit the real value).
# Get one privately at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace-with-your-google-ai-studio-key

# Required Gemma 4 model identifier. Do not replace with another model.
GEMMA_MODEL=gemma-4-26b-a4b-it
